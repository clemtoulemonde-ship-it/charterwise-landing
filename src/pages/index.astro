---
import Layout from '../layouts/Layout.astro';

const APP_STORE_URL = 'https://apps.apple.com/us/app/charterwise/id6761048802';
const FLEET_LOGIN_URL = 'https://fleet.charterwise.app';
const CONTACT_EMAIL = 'hello@charterwise.app';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "CharterWise Fleet",
  "operatingSystem": "Web",
  "applicationCategory": "BusinessApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "EUR"
  },
  "description": "CharterWise Fleet gives charter companies a clear, verified read on fleet condition — captured at every digital handover, scored system by system, and prioritized by what needs attention next.",
  "url": "https://charterwise.app",
  "screenshot": "https://charterwise.app/og-image.png",
  "featureList": "Condition Dashboard, Vessel Management, Digital Handover & E-signature, Team & Multi-Base Access, Maintenance Queue"
};
---

<Layout canonicalPath="/">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <!-- NAV -->
  <header class="sticky top-0 z-50 bg-gradient-to-b from-[#1B3A5C] to-[#0F2642] shadow-lg border-b border-white/10">
    <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5">
        <img src="/icon-white.svg" alt="CharterWise" class="h-9 w-9" />
        <span class="text-white font-bold text-2xl tracking-tight">CharterWise</span>
      </a>
      <div class="hidden md:flex items-center gap-8 text-sm font-medium text-white/80">
        <a href="#how-it-works" class="hover:text-white transition-colors">How it works</a>
        <a href="#features" class="hover:text-white transition-colors">Features</a>
        <a href="#faq" class="hover:text-white transition-colors">FAQ</a>
      </div>
      <div class="flex items-center gap-3">
        <a
          href={FLEET_LOGIN_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex text-white/70 hover:text-white text-sm font-semibold transition-colors"
        >
          Log in
        </a>
        <a
          href="#contact"
          class="bg-gradient-to-r from-[#D4A843] to-[#C49833] text-white font-bold text-sm px-5 py-2.5 rounded-xl hover:opacity-90 active:scale-95 transition-all"
        >
          Get in touch
        </a>
      </div>
    </nav>
  </header>

  <main>
    <!-- HERO -->
    <section class="relative bg-gradient-to-b from-[#1B3A5C] via-[#16304E] to-[#0F2642] text-white min-h-[88vh] flex items-center overflow-hidden">
      <div class="absolute inset-0 opacity-3"
        style="background-image: radial-gradient(circle, #ffffff 1px, transparent 1px); background-size: 32px 32px;">
      </div>

      <div class="relative max-w-6xl mx-auto px-6 py-24 grid md:grid-cols-[1fr_1.3fr] gap-12 items-center w-full">
        <div>
          <div class="inline-flex items-center gap-2 bg-white/10 text-white/90 text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full mb-6">
            For charter companies &amp; yacht fleets
          </div>
          <h1 class="text-5xl md:text-6xl font-bold leading-tight mb-6">
            A clear, accurate read on your fleet's health —<br />improving with every charter.
          </h1>
          <p class="text-white/75 text-lg leading-relaxed mb-10 max-w-lg">
            As a Base Manager, CharterWise Fleet shows you exactly where every boat stands today, verified at every handover — not projected from a maintenance log. See what's improving, what needs attention, and make sure the next charterer steps onto a better boat than the last one did.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 items-center">
            <a
              href="#contact"
              class="bg-gradient-to-r from-[#D4A843] to-[#C49833] text-white font-bold text-base px-8 py-4 rounded-xl hover:opacity-90 active:scale-95 transition-all text-center"
            >
              Get in touch
            </a>
            <a href="#features" class="text-white/70 hover:text-white text-sm font-semibold transition-colors">
              See what's included ↓
            </a>
          </div>
        </div>

        <!-- Hero screenshot: the real Fleet dashboard -->
        <div class="hidden md:block">
          <div class="relative w-full rounded-xl overflow-hidden border border-white/10 shadow-2xl">
            <img
              src="/screenshots-fleet/dashboard.jpg"
              alt="CharterWise Fleet condition dashboard"
              class="w-full block cursor-zoom-in js-shot"
              data-shot-index="0"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Trust bar -->
    <section class="bg-white border-b border-[#E5E7EB]">
      <div class="max-w-6xl mx-auto px-6 py-5 flex flex-wrap items-center justify-center gap-x-10 gap-y-3 text-sm text-[#6B7280] font-medium">
        <div class="flex items-center gap-2"><span>✍️</span> Digital handover &amp; e-signature</div>
        <div class="flex items-center gap-2"><span>★</span> Verified at every handover, not self-reported</div>
        <div class="flex items-center gap-2"><span>🔧</span> Issues prioritized by next charter</div>
        <div class="flex items-center gap-2"><span>👥</span> Role-scoped team access</div>
      </div>
    </section>

    <!-- PROBLEM -->
    <section class="bg-[#F8F6F1] py-24">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <p class="text-xs font-bold uppercase tracking-widest text-[#D4A843] mb-4">The problem</p>
        <h2 class="text-4xl font-bold text-[#1B3A5C] mb-8 leading-tight">
          You want your fleet to keep getting better.<br class="hidden sm:block" /> You can't tell if it actually is.
        </h2>
        <div class="text-[#6B7280] text-lg leading-relaxed space-y-5 text-left">
          <p>
            A boat comes back at 10am. Another guest is due at 5pm. As a Base Manager, your job is to keep every boat in better shape than the charter before — but your team walks it with a paper clipboard: no photos worth keeping, no timestamp, no record beyond a signature. If a fender's missing or the watermaker's dead, it's a phone call and a guess. Multiply that across every base, every Saturday.
          </p>
          <p>
            Three weeks later, when a deposit dispute lands or the same issue turns up on a different boat, there's nothing to point back to — and no way to tell whether your fleet's overall condition is actually trending up or down.
          </p>
          <p class="font-semibold text-[#1B3A5C]">
            CharterWise Fleet replaces the clipboard with a digital handover that captures verified condition data as it happens — so you always have an accurate, current read on every boat, and can see what's improving before the next charter starts.
          </p>
        </div>
      </div>
    </section>

    <!-- DIFFERENTIATOR PULL-QUOTE -->
    <section class="bg-[#0F2642] py-16">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <p class="text-white text-2xl md:text-3xl font-bold leading-snug">
          Real, verified condition data on every boat you run —
          <span class="text-[#D4A843]">captured handover to handover, so you always know exactly where your fleet stands.</span>
        </p>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how-it-works" class="bg-white py-24">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16">
          <p class="text-xs font-bold uppercase tracking-widest text-[#D4A843] mb-4">How it works</p>
          <h2 class="text-4xl font-bold text-[#1B3A5C]">Fleet operations, finally in one system.</h2>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          {[
            {
              step: '1',
              icon: '⚓',
              title: 'Set up your fleet & team',
              desc: 'Add every boat you run, then invite your team with the right access — Admin, Base Manager, Skipper, Billing, or Vessel Owner. Each role sees exactly what it needs to.',
            },
            {
              step: '2',
              icon: '✍️',
              title: 'Guests check in — digitally, signed',
              desc: 'At handover, guests walk through 5 systems, flag issues with photos, and sign off electronically — no app download required. A branded PDF report is generated as it happens.',
            },
            {
              step: '3',
              icon: '🔧',
              title: 'Issues surface, your team acts',
              desc: "Recurring issues surface in your fleet's condition score, and clear when the next guest confirms a fix held. You always know whether things are trending up before the next charter starts.",
            },
          ].map(({ step, icon, title, desc }) => (
            <div class="bg-[#F8F6F1] rounded-2xl p-8">
              <div class="flex items-center gap-4 mb-5">
                <div class="w-10 h-10 rounded-full bg-[#1B3A5C] text-white text-sm font-bold flex items-center justify-center flex-shrink-0">
                  {step}
                </div>
                <span class="text-2xl">{icon}</span>
                <h3 class="font-bold text-xl text-[#1B3A5C]">{title}</h3>
              </div>
              <p class="text-[#6B7280] leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section id="features" class="bg-[#F8F6F1] py-24">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16">
          <p class="text-xs font-bold uppercase tracking-widest text-[#D4A843] mb-4">Features</p>
          <h2 class="text-4xl font-bold text-[#1B3A5C]">Everything your fleet operation runs on.</h2>
        </div>

        <div class="space-y-20">

          <!-- Feature 1: Condition Dashboard -->
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-[#D4A843] mb-3">Condition Dashboard</p>
              <h3 class="text-3xl font-bold text-[#1B3A5C] mb-5">Your whole fleet, always visible.</h3>
              <p class="text-[#6B7280] leading-relaxed">
                A live condition score for every boat you run, built from real handover and check-in reports — entered once, by whoever's actually there (guest, skipper, or base manager), never re-compiled by your team afterward. Sorted worst-first, so you see what needs attention without hunting for it.
              </p>
            </div>
            <div class="rounded-2xl overflow-hidden border border-[#E5E7EB] shadow-sm">
              <img src="/screenshots-fleet/dashboard.jpg" alt="Fleet condition dashboard" class="w-full block cursor-zoom-in js-shot" data-shot-index="0" />
              <p class="text-xs text-[#9CA3AF] text-center py-2 bg-white">This is what a charter company logs into today — not a mockup.</p>
            </div>
          </div>

          <!-- Feature 2: Vessel roster -->
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div class="order-2 md:order-1 rounded-2xl overflow-hidden border border-[#E5E7EB] shadow-sm">
              <img src="/screenshots-fleet/vessel-detail.jpg" alt="Vessel detail and management" class="w-full block cursor-zoom-in js-shot" data-shot-index="1" />
            </div>
            <div class="order-1 md:order-2">
              <p class="text-xs font-bold uppercase tracking-widest text-[#D4A843] mb-3">Vessel Management</p>
              <h3 class="text-3xl font-bold text-[#1B3A5C] mb-5">Every boat, scored system by system.</h3>
              <p class="text-[#6B7280] leading-relaxed">
                Open issues broken down by Safety, Sails &amp; Rigging, Engine &amp; Electrics, Hull &amp; Deck, and Comfort &amp; Cleanliness, tracked straight back to the handover that found them — no paper clipboard, no guesswork. When an issue is flagged, it resurfaces at the next check-in, so you always know if a fix actually held, boat by boat.
              </p>
            </div>
          </div>

          <!-- Feature 3: Digital Handover + deposits -->
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-[#D4A843] mb-3">Digital Handover</p>
              <h3 class="text-3xl font-bold text-[#1B3A5C] mb-5">The handover moment, signed and stored.</h3>
              <p class="text-[#6B7280] leading-relaxed">
                One click sends the branded pre-charter pack straight from a booking. Guests review the boat and sign off through a no-login web link — no app to install, just whatever device they already have in hand. A branded PDF handover report is generated and stored as it happens, and any deposit is tracked against it from pickup to return.
              </p>
            </div>
            <div class="rounded-2xl overflow-hidden border border-[#E5E7EB] shadow-sm">
              <img src="/screenshots-fleet/send-pack.jpg" alt="Send guest handover pack from a booking" class="w-full block cursor-zoom-in js-shot" data-shot-index="2" />
            </div>
          </div>

          <!-- Feature 4: Team & multi-base -->
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div class="order-2 md:order-1 rounded-2xl overflow-hidden border border-[#E5E7EB] shadow-sm">
              <img src="/screenshots-fleet/team.jpg" alt="Team and multi-base member management" class="w-full block cursor-zoom-in js-shot" data-shot-index="3" />
            </div>
            <div class="order-1 md:order-2">
              <p class="text-xs font-bold uppercase tracking-widest text-[#D4A843] mb-3">Team &amp; Multi-Base</p>
              <h3 class="text-3xl font-bold text-[#1B3A5C] mb-5">The right access, for every role.</h3>
              <p class="text-[#6B7280] leading-relaxed">
                Invite your team with scoped roles — Admin, Base Manager, Skipper, Billing, or Vessel Owner. A Base Manager only ever sees their own base's boats and staff; a Skipper only sees their assigned vessel. A real permission structure, not a flat user list.
              </p>
            </div>
          </div>

          <!-- Feature 5: Maintenance queue (illustrative mockup, feature in active development) -->
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-[#D4A843] mb-3">Maintenance Queue <span class="text-[#6B7280] normal-case font-semibold tracking-normal">— in development</span></p>
              <h3 class="text-3xl font-bold text-[#1B3A5C] mb-5">Fixed in time for whoever's next.</h3>
              <p class="text-[#6B7280] leading-relaxed">
                Issues raised at handover route straight into a fleet-wide queue, prioritized by each boat's <span class="font-semibold text-[#111827]">next confirmed charter</span> — not who filed first or shouted loudest. Assign a fix to a base manager or let staff self-claim it; either way, your team always knows which job actually matters today, so the guest stepping aboard next gets a boat that's ready, not just next in line.
              </p>
            </div>
            <div class="space-y-3">
              <div class="bg-white rounded-2xl p-6 border border-[#E5E7EB] shadow-sm">
                <p class="text-xs font-bold uppercase tracking-widest text-[#6B7280] mb-4">Maintenance queue · sorted by next charter</p>
                <div class="flex items-center justify-between bg-[#FDECEC] border border-[#EF444433] rounded-xl px-4 py-3 mb-2">
                  <div>
                    <p class="text-xs font-semibold text-[#6B7280] mb-0.5">Inishmore · Sails &amp; Rigging</p>
                    <p class="text-sm font-semibold text-[#111827]">Lines are worn out</p>
                    <p class="text-xs font-bold text-[#C6342E] mt-1">Next charter: tomorrow</p>
                  </div>
                  <span class="text-xs font-bold px-2.5 py-1 rounded-full text-[#B45309] bg-[#F59E0B18]">Unassigned</span>
                </div>
                <div class="flex items-center justify-between bg-[#F8F6F1] rounded-xl px-4 py-3">
                  <div>
                    <p class="text-xs font-semibold text-[#6B7280] mb-0.5">Aurora · Engine &amp; Electrics</p>
                    <p class="text-sm font-semibold text-[#111827]">Intermittent alarm on start</p>
                    <p class="text-xs font-bold text-[#6B7280] mt-1">Next charter: in 12 days</p>
                  </div>
                  <span class="text-xs font-bold px-2.5 py-1 rounded-full text-[#0B7E73] bg-[#0D948818]">Assigned · Christos</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Feature 6: Fleet Mobile teaser (no real build yet — text only, see README note) -->
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div class="order-2 md:order-1 flex justify-center">
              <div class="w-full max-w-[280px] rounded-2xl border border-[#E5E7EB] bg-white shadow-sm p-8 flex flex-col items-center text-center gap-3">
                <span class="text-4xl">📱</span>
                <p class="text-xs font-bold uppercase tracking-widest text-[#6B7280]">Fleet Mobile</p>
                <p class="text-sm text-[#9CA3AF]">Screens coming soon as the app rolls out</p>
              </div>
            </div>
            <div class="order-1 md:order-2">
              <p class="text-xs font-bold uppercase tracking-widest text-[#D4A843] mb-3">Fleet Mobile <span class="text-[#6B7280] normal-case font-semibold tracking-normal">— in development</span></p>
              <h3 class="text-3xl font-bold text-[#1B3A5C] mb-5">Built for the dock, not the office.</h3>
              <p class="text-[#6B7280] leading-relaxed">
                A dedicated app for your skippers and base managers — run handovers, capture signatures, and flag issues from the boat itself, even offline. Until it's rolled out to your fleet, every handover runs the same way from the Fleet web dashboard on any device. See it below.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- SEE IT IN ACTION: web dashboard -->
    <section class="bg-white py-24 overflow-hidden">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16">
          <p class="text-xs font-bold uppercase tracking-widest text-[#D4A843] mb-4">The web dashboard</p>
          <h2 class="text-4xl font-bold text-[#1B3A5C] mb-4">This is what your team logs into.</h2>
          <p class="text-[#6B7280] max-w-2xl mx-auto">The same fleet data your office runs the business on — no separate system to keep in sync.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <figure class="rounded-xl overflow-hidden border border-[#E5E7EB] shadow-sm">
            <div class="h-56 overflow-hidden"><img src="/screenshots-fleet/send-pack.jpg" alt="Send guest handover pack" class="w-full h-full object-cover object-top cursor-zoom-in js-shot" data-shot-index="2" /></div>
            <figcaption class="text-xs font-semibold text-[#6B7280] uppercase tracking-wider text-center py-3 bg-[#F8F6F1]">Send guest pack</figcaption>
          </figure>
          <figure class="rounded-xl overflow-hidden border border-[#E5E7EB] shadow-sm">
            <div class="h-56 overflow-hidden"><img src="/screenshots-fleet/vessel-detail.jpg" alt="Vessel detail" class="w-full h-full object-cover object-top cursor-zoom-in js-shot" data-shot-index="1" /></div>
            <figcaption class="text-xs font-semibold text-[#6B7280] uppercase tracking-wider text-center py-3 bg-[#F8F6F1]">Vessel detail</figcaption>
          </figure>
          <figure class="rounded-xl overflow-hidden border border-[#E5E7EB] shadow-sm">
            <div class="h-56 overflow-hidden"><img src="/screenshots-fleet/team.jpg" alt="Team management" class="w-full h-full object-cover object-top cursor-zoom-in js-shot" data-shot-index="3" /></div>
            <figcaption class="text-xs font-semibold text-[#6B7280] uppercase tracking-wider text-center py-3 bg-[#F8F6F1]">Team &amp; access</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- CONTACT FORM (replaces mailto CTA) -->
    <section id="contact" class="bg-[#1B3A5C] py-24">
      <div class="max-w-xl mx-auto px-6">
        <div class="text-center mb-10">
          <h2 class="text-4xl font-bold text-white mb-4">Ready for a clear, accurate read on your fleet?</h2>
          <p class="text-white/70 text-lg">Tell us a bit about your fleet — we'll get back to you directly.</p>
        </div>

        <form id="fleet-contact-form" class="bg-white rounded-2xl p-8 shadow-2xl space-y-5">
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-[#6B7280] mb-1.5" for="cf-name">Your name</label>
              <input id="cf-name" name="name" required type="text" class="w-full rounded-lg border border-[#E5E7EB] px-3.5 py-2.5 text-sm text-[#111827] focus:outline-none focus:ring-2 focus:ring-[#D4A843]/40 focus:border-[#D4A843]" placeholder="Irini Castellanos" />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-[#6B7280] mb-1.5" for="cf-email">Work email</label>
              <input id="cf-email" name="work_email" required type="email" class="w-full rounded-lg border border-[#E5E7EB] px-3.5 py-2.5 text-sm text-[#111827] focus:outline-none focus:ring-2 focus:ring-[#D4A843]/40 focus:border-[#D4A843]" placeholder="you@fleet.com" />
            </div>
          </div>
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-[#6B7280] mb-1.5" for="cf-company">Company name</label>
              <input id="cf-company" name="company_name" required type="text" class="w-full rounded-lg border border-[#E5E7EB] px-3.5 py-2.5 text-sm text-[#111827] focus:outline-none focus:ring-2 focus:ring-[#D4A843]/40 focus:border-[#D4A843]" placeholder="Dream Yacht Charter" />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-[#6B7280] mb-1.5" for="cf-size">Fleet size</label>
              <select id="cf-size" name="fleet_size" class="w-full rounded-lg border border-[#E5E7EB] px-3.5 py-2.5 text-sm text-[#111827] focus:outline-none focus:ring-2 focus:ring-[#D4A843]/40 focus:border-[#D4A843]">
                <option>1–5 boats</option>
                <option>6–20 boats</option>
                <option>21+ boats</option>
              </select>
            </div>
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-[#6B7280] mb-1.5" for="cf-message">Anything specific? (optional)</label>
            <textarea id="cf-message" name="message" rows="3" class="w-full rounded-lg border border-[#E5E7EB] px-3.5 py-2.5 text-sm text-[#111827] focus:outline-none focus:ring-2 focus:ring-[#D4A843]/40 focus:border-[#D4A843]" placeholder="Bases, current handover process, anything we should know"></textarea>
          </div>
          <p id="fleet-contact-error" class="hidden text-sm text-red-600"></p>
          <button type="submit" id="fleet-contact-submit" class="w-full bg-gradient-to-r from-[#D4A843] to-[#C49833] text-white font-bold text-base py-3.5 rounded-xl hover:opacity-90 active:scale-95 transition-all disabled:opacity-60">
            Get in touch
          </button>
          <p class="text-xs text-[#9CA3AF] text-center">No spam, no auto-drip sequence — this goes straight to the founder's inbox.</p>
        </form>

        <div id="fleet-contact-success" class="hidden bg-white rounded-2xl p-10 shadow-2xl text-center">
          <div class="text-4xl mb-4">⚓</div>
          <h3 class="text-2xl font-bold text-[#1B3A5C] mb-2">Thanks — got it.</h3>
          <p class="text-[#6B7280]">We'll be in touch soon to talk through your fleet.</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="bg-white py-24">
      <div class="max-w-2xl mx-auto px-6">
        <div class="text-center mb-12">
          <p class="text-xs font-bold uppercase tracking-widest text-[#D4A843] mb-4">FAQ</p>
          <h2 class="text-4xl font-bold text-[#1B3A5C]">Common questions</h2>
        </div>
        <div class="space-y-3">
          {[
            {
              q: 'What does setup look like for my fleet?',
