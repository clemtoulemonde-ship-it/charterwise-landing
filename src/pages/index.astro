  <!-- SCREENSHOT LIGHTBOX -->
  <div
    id="shot-lightbox"
    class="hidden fixed inset-0 z-[100] bg-black/90 items-center justify-center px-4 py-10"
  >
    <button
      id="shot-lightbox-close"
      aria-label="Close"
      class="absolute top-5 right-5 text-white/70 hover:text-white text-3xl leading-none w-10 h-10 flex items-center justify-center"
    >
      &times;
    </button>
    <button
      id="shot-lightbox-prev"
      aria-label="Previous screenshot"
      class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 text-white/70 hover:text-white w-12 h-12 flex items-center justify-center text-3xl"
    >
      ‹
    </button>
    <button
      id="shot-lightbox-next"
      aria-label="Next screenshot"
      class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 text-white/70 hover:text-white w-12 h-12 flex items-center justify-center text-3xl"
    >
      ›
    </button>
    <div class="max-w-6xl w-full flex flex-col items-center gap-4">
      <img id="shot-lightbox-img" src="" alt="" class="max-h-[85vh] w-auto rounded-lg shadow-2xl" />
      <p id="shot-lightbox-caption" class="text-white/70 text-sm text-center"></p>
    </div>
  </div>

  <script>
    import { createClient } from '@supabase/supabase-js';

    // Public anon key — safe in a client bundle by design, same key the
    // mobile app and Fleet web ship with. RLS on fleet_contact_submissions
    // (patch_064) grants INSERT only, no SELECT, so this key can never read
    // submissions back.
    const supabase = createClient(
      'https://encnmjtyoemmgcqqhhiv.supabase.co',
      'sb_publishable_Y3VxQhw_I75207SxIz1yyQ_eVFp9S3i',
    );

    const form = document.getElementById('fleet-contact-form') as HTMLFormElement;
    const success = document.getElementById('fleet-contact-success')!;
    const errorEl = document.getElementById('fleet-contact-error')!;
    const submitBtn = document.getElementById('fleet-contact-submit') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';

      const data = new FormData(form);
      const { error } = await supabase.from('fleet_contact_submissions').insert({
        name: data.get('name'),
        work_email: data.get('work_email'),
        company_name: data.get('company_name'),
        fleet_size: data.get('fleet_size'),
        message: data.get('message') || null,
      });

      if (error) {
        errorEl.textContent = "Something went wrong sending that — please email hello@charterwise.app directly.";
        errorEl.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Get in touch';
        return;
      }

      form.classList.add('hidden');
      success.classList.remove('hidden');
    });
  </script>

  <script>
    // Full-page lightbox carousel: every Fleet screenshot on the page maps
    // (via data-shot-index) to one of 4 unique real screens -- clicking any
    // instance opens the same carousel at that screen, so visitors can flip
    // through the whole product tour in one flow regardless of where they
    // clicked in on the page.
    const shots = [
      { src: '/screenshots-fleet/dashboard.jpg', caption: 'Condition Dashboard — your whole fleet, always visible.' },
      { src: '/screenshots-fleet/vessel-detail.jpg', caption: 'Vessel Management — every boat, scored system by system.' },
      { src: '/screenshots-fleet/send-pack.jpg', caption: 'Digital Handover — the guest pack, sent in one click.' },
      { src: '/screenshots-fleet/team.jpg', caption: 'Team & Multi-Base — the right access, for every role.' },
    ];

    const lightbox = document.getElementById('shot-lightbox')!;
    const lightboxImg = document.getElementById('shot-lightbox-img') as HTMLImageElement;
    const lightboxCaption = document.getElementById('shot-lightbox-caption')!;
    const closeBtn = document.getElementById('shot-lightbox-close')!;
    const prevBtn = document.getElementById('shot-lightbox-prev')!;
    const nextBtn = document.getElementById('shot-lightbox-next')!;

    let currentIndex = 0;

    function render() {
      const shot = shots[currentIndex];
      lightboxImg.src = shot.src;
      lightboxImg.alt = shot.caption;
      lightboxCaption.textContent = shot.caption;
    }

    function open(index: number) {
      currentIndex = index;
      render();
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
    }

    function prev() {
      currentIndex = (currentIndex - 1 + shots.length) % shots.length;
      render();
    }

    function next() {
      currentIndex = (currentIndex + 1) % shots.length;
      render();
    }

    document.querySelectorAll<HTMLElement>('.js-shot').forEach((el) => {
      el.addEventListener('click', () => open(Number(el.dataset.shotIndex)));
    });

    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', prev);
    nextBtn.addEventListener('click', next);

    // Click the dark backdrop (but not the image/caption/controls) to close.
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });

    document.addEventListener('keydown', (e) => {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') prev();
      if (e.key === 'ArrowRight') next();
    });
  </script>
</Layout>
