---
import Layout from '../layouts/Layout.astro';

const APP_STORE_URL = 'https://apps.apple.com/us/app/charterwise/id6761048802';
const CONTACT_EMAIL = 'hello@charterwise.app';
const REQUEST_ACCESS_URL = `mailto:${CONTACT_EMAIL}?subject=CharterWise%20Fleet%20%E2%80%94%20Early%20Access%20Request`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "CharterWise",
  "operatingSystem": "iOS",
  "applicationCategory": "BusinessApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "EUR"
  },
  "description": "CharterWise gives charter companies fleet condition intelligence powered by guest check-in reports — open issues by system, photo evidence, and real condition scores across every boat.",
  "url": "https://charterwise.app",
  "screenshot": "https://charterwise.app/og-image.png",
  "featureList": "Fleet Condition Monitoring, Guest Check-in Reports, Issue Tracking, Condition Scores"
};
---

<Layout canonicalPath="/">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <!-- NAV -->
  <header class="sticky top-0 z-50 bg-gradient-to-b from-[#1B3A5C] to-[#0F2642] shadow-lg border-b border-white/10">
    <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5">
        <img src="/icon.png" alt="CharterWise" class="h-11 w-11 rounded-xl object-cover" />
        <span class="text-white font-bold text-2xl tracking-tight">CharterWise</span>
      </a>
      <div class="hidden md:flex items-center gap-8 text-sm font-medium text-white/80">
        <a href="#how-it-works" class="hover:text-white transition-colors">How it works</a>
        <a href="#features" class="hover:text-white transition-colors">Features</a>
        <a href="#faq" class="hover:text-white transition-colors">FAQ</a>
      </div>
      <a
        href={REQUEST_ACCESS_URL}
        class="bg-gradient-to-r from-[#D4A843] to-[#C49833] text-white font-bold text-sm px-5 py-2.5 rounded-xl hover:opacity-90 active:scale-95 transition-all"
      >
        Request early access
      </a>
    </nav>
  </header>

  <main>
    <!-- HERO -->
    <section class="relative bg-gradient-to-b from-[#1B3A5C] via-[#16304E] to-[#0F2642] text-white min-h-[90vh] flex items-center overflow-hidden">
      <div class="absolute inset-0 opacity-3"
        style="background-image: radial-gradient(circle, #ffffff 1px, transparent 1px); background-size: 32px 32px;">
      </div>

      <div class="relative max-w-6xl mx-auto px-6 py-24 grid md:grid-cols-2 gap-16 items-center w-full">
        <div>
          <div class="inline-flex items-center gap-2 bg-white/10 text-white/90 text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full mb-6">
            Now in early access
          </div>
          <h1 class="text-5xl md:text-6xl font-bold leading-tight mb-6">
            Fleet condition intelligence,<br />powered by your guests.
          </h1>
          <p class="text-white/75 text-lg leading-relaxed mb-10 max-w-lg">
            CharterWise turns every guest handover into structured fleet data — open issues by system, photo evidence, and a clear condition read on every boat in your fleet. No manual entry from your team.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 items-center">
            <a
              href={REQUEST_ACCESS_URL}
              class="bg-gradient-to-r from-[#D4A843] to-[#C49833] text-white font-bold text-base px-8 py-4 rounded-xl hover:opacity-90 active:scale-95 transition-all text-center"
            >
              Request early access
            </a>
          </div>
          <p class="text-white/40 text-sm mt-4">Free during early access · No setup required</p>
        </div>

        <!-- Hero screenshot -->
        <div class="hidden md:flex justify-center">
          <div class="relative" style="width:240px">
            <div class="rounded-[36px] overflow-hidden border-[8px] border-[#111] shadow-2xl">
              <img src="/screenshots/explore.png" alt="CharterWise fleet condition view" class="w-full block" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust bar -->
    <section class="bg-white border-b border-[#E5E7EB]">
      <div class="max-w-6xl mx-auto px-6 py-5 flex flex-col sm:flex-row items-center justify-center gap-6 sm:gap-12 text-sm text-[#6B7280] font-medium">
        <div class="flex items-center gap-2"><span>⚓</span> No manual data entry</div>
        <div class="flex items-center gap-2"><span>🛡</span> Guest check-in reports</div>
        <div class="flex items-center gap-2"><span>★</span> Condition scores by system</div>
      </div>
    </section>

    <!-- PROBLEM -->
    <section class="bg-[#F8F6F1] py-24">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <p class="text-xs font-bold uppercase tracking-widest text-[#D4A843] mb-4">The problem</p>
        <h2 class="text-4xl font-bold text-[#1B3A5C] mb-8 leading-tight">
          Your fleet leaves the dock.<br class="hidden sm:block" /> What happens next is invisible to you.
        </h2>
        <div class="text-[#6B7280] text-lg leading-relaxed space-y-5 text-left">
          <p>
            You manage a fleet across one or more bases. Maintenance logs tell you what was serviced. They don't tell you what guests actually found when they stepped aboard — the seized furler, the intermittent engine alarm, the head that's been borderline for three rotations.
          </p>
          <p>
            By the time an issue surfaces in a complaint or a damage deposit dispute, it's already been through a dozen handovers. You're always one step behind the condition of your own fleet.
          </p>
          <p class="font-semibold text-[#1B3A5C]">
            CharterWise captures that moment automatically: a structured check-in report, filed by each guest at handover, feeding directly into your fleet's condition record.
          </p>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how-it-works" class="bg-white py-24">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16">
          <p class="text-xs font-bold uppercase tracking-widest text-[#D4A843] mb-4">How it works</p>
          <h2 class="text-4xl font-bold text-[#1B3A5C]">Fleet condition tracking, finally automated.</h2>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          {[
            {
              step: '1',
              icon: '⚓',
              title: 'Your fleet, always visible',
              desc: "Every boat in your fleet has a live condition profile — open issues by system, photos from real handovers, and a clear condition score updated after every check-in. No manual entry from your team.",
            },
            {
              step: '2',
              icon: '📋',
              title: 'Guests report at handover',
              desc: "At check-in, guests walk through 5 systems — safety, rigging, engine, hull, interior. They flag issues and attach photos. Each report is timestamped and attached to that boat's permanent record automatically.",
            },
            {
              step: '3',
              icon: '🔔',
              title: 'Issues surface, not surprises',
              desc: "When an issue recurs across multiple check-ins, it surfaces in the condition score. Recurring problems become visible before they become complaints — giving your maintenance team data to act on.",
            },
          ].map(({ step, icon, title, desc }) => (
            <div class="bg-[#F8F6F1] rounded-2xl p-8">
              <div class="flex items-center gap-4 mb-5">
                <div class="w-10 h-10 rounded-full bg-[#1B3A5C] text-white text-sm font-bold flex items-center justify-center flex-shrink-0">
                  {step}
                </div>
                <span class="text-2xl">{icon}</span>
                <h3 class="font-bold text-xl text-[#1B3A5C]">{title}</h3>
              </div>
              <p class="text-[#6B7280] leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SCREENSHOTS -->
    <section class="bg-[#F8F6F1] py-24 overflow-hidden">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16">
          <p class="text-xs font-bold uppercase tracking-widest text-[#D4A843] mb-4">The app</p>
          <h2 class="text-4xl font-bold text-[#1B3A5C]">See it in action.</h2>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-6 gap-6 md:gap-4 justify-items-center">
          {[
            { src: '/screenshots/explore.png', label: 'Explore boats' },
            { src: '/screenshots/boat-detail.png', label: 'Boat profile' },
            { src: '/screenshots/pickup-report.png', label: 'Condition Assessment' },
            { src: '/screenshots/reviews.png', label: 'Reviews' },
            { src: '/screenshots/checkin.png', label: 'Check-in report' },
            { src: '/screenshots/home.png', label: 'Start a check-in' },
          ].map(({ src, label }) => (
            <div class="flex flex-col items-center gap-3 w-full max-w-[160px]">
              <button
                class="screenshot-thumb rounded-[32px] overflow-hidden border-[7px] border-[#111] shadow-xl w-full cursor-zoom-in transition-transform hover:scale-105"
                data-src={src}
                data-label={label}
                aria-label={`View ${label} screenshot`}
              >
                <img src={src} alt={label} class="w-full block pointer-events-none" />
              </button>
              <p class="text-xs font-semibold text-[#6B7280] uppercase tracking-wider">{label}</p>
            </div>
          ))}
        </div>

        <!-- Lightbox -->
        <div id="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4" role="dialog" aria-modal="true">
          <button id="lightbox-close" class="absolute top-4 right-5 text-white/70 hover:text-white text-3xl leading-none" aria-label="Close">&times;</button>
          <button id="lightbox-prev" class="absolute left-3 md:left-6 text-white/70 hover:text-white text-4xl leading-none px-2 py-4" aria-label="Previous">&#8249;</button>
          <button id="lightbox-next" class="absolute right-3 md:right-6 text-white/70 hover:text-white text-4xl leading-none px-2 py-4" aria-label="Next">&#8250;</button>
          <div class="relative max-h-full flex flex-col items-center gap-4">
            <img id="lightbox-img" src="" alt="" class="max-h-[85vh] w-auto rounded-[28px] border-[6px] border-[#111] shadow-2xl" />
            <p id="lightbox-label" class="text-white/70 text-sm font-semibold uppercase tracking-wider"></p>
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section id="features" class="bg-[#F8F6F1] py-24">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16">
          <p class="text-xs font-bold uppercase tracking-widest text-[#D4A843] mb-4">Features</p>
          <h2 class="text-4xl font-bold text-[#1B3A5C]">Fleet intelligence that runs itself.</h2>
        </div>

        <div class="space-y-20">
          <!-- Feature 1 -->
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-[#D4A843] mb-3">Condition Assessment</p>
              <h3 class="text-3xl font-bold text-[#1B3A5C] mb-5">Every boat in your fleet, always visible.</h3>
              <p class="text-[#6B7280] leading-relaxed mb-6">
                Every boat profile shows a live condition assessment built from guest check-in reports — open issues by system and photos from real handovers. When an issue is flagged in one check-in, it automatically surfaces in the next guest's report so nothing slips between rotations.
              </p>
              <div class="space-y-3">
                {[
                  { color: '#10B981', label: 'Good to go', desc: 'No significant open issues' },
                  { color: '#F59E0B', label: 'Minor things', desc: 'Some non-critical issues flagged' },
                ].map(({ color, label, desc }) => (
                  <div class="flex items-center gap-4 bg-white rounded-xl px-4 py-3 border border-[#E5E7EB]">
                    <span class="w-3 h-3 rounded-full flex-shrink-0" style={`background:${color}`}></span>
                    <span class="font-semibold text-sm" style={`color:${color}`}>{label}</span>
                    <span class="text-sm text-[#6B7280]">— {desc}</span>
                  </div>
                ))}
              </div>
            </div>
            <div class="space-y-4">
              <!-- Boat profile card -->
              <div class="bg-white rounded-2xl p-6 border border-[#E5E7EB] shadow-sm">
                <p class="text-xs font-bold uppercase tracking-widest text-[#6B7280] mb-4">On the boat profile</p>
                <div class="flex items-start justify-between mb-3">
                  <div>
                    <p class="font-bold text-sm text-[#111827]">Inishmore</p>
                    <p class="text-xs text-[#6B7280]">Lagoon 42 · Catamaran · Split, Croatia</p>
                  </div>
                  <span class="text-xs font-bold px-2.5 py-1 rounded-full" style="color:#F59E0B; background:#F59E0B18">Minor things</span>
                </div>
                <div class="bg-[#F8F6F1] rounded-xl px-4 py-3">
                  <p class="text-xs font-semibold text-[#6B7280] uppercase tracking-wider mb-1.5">Sails &amp; Rigging</p>
                  <p class="text-sm text-[#111827]">Lines are worn out</p>
                </div>
              </div>
              <!-- Check-in card -->
              <div class="bg-white rounded-2xl p-6 border border-[#E5E7EB] shadow-sm">
                <p class="text-xs font-bold uppercase tracking-widest text-[#6B7280] mb-4">At next handover</p>
                <div class="bg-[#FFFBEB] border border-[#F59E0B33] rounded-xl px-4 py-3 mb-3">
                  <p class="text-xs font-semibold text-[#6B7280] mb-1">Issue from previous report · #1</p>
                  <p class="text-sm font-semibold text-[#111827]">Lines are worn out</p>
                </div>
                <div class="flex gap-2">
                  <div class="flex-1 flex items-center justify-center gap-1.5 border border-[#E5E7EB] rounded-lg px-3 py-2 text-xs font-semibold text-[#6B7280]">
                    <span>✓</span> Looks fixed
                  </div>
                  <div class="flex-1 flex items-center justify-center gap-1.5 border border-[#E5E7EB] rounded-lg px-3 py-2 text-xs font-semibold text-[#6B7280]">
                    <span>⚑</span> Still there
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Feature 2 -->
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div class="order-2 md:order-1 bg-white rounded-2xl p-8 border border-[#E5E7EB] shadow-sm">
              <p class="text-xs font-bold uppercase tracking-widest text-[#6B7280] mb-5">Check-in categories</p>
              <div class="grid grid-cols-2 gap-3">
                {[
                  { icon: '🛡', label: 'Safety' },
                  { icon: '⛵', label: 'Sails & Rigging' },
                  { icon: '⚙️', label: 'Engine & Electrics' },
                  { icon: '⚓', label: 'Hull & Deck' },
                  { icon: '🛏', label: 'Comfort & Cleanliness' },
                ].map(({ icon, label }) => (
                  <div class="flex items-center gap-3 bg-[#F8F6F1] rounded-xl px-4 py-3">
                    <span>{icon}</span>
                    <span class="font-semibold text-sm text-[#1B3A5C]">{label}</span>
                  </div>
                ))}
              </div>
            </div>
            <div class="order-1 md:order-2">
              <p class="text-xs font-bold uppercase tracking-widest text-[#D4A843] mb-3">Check-in Report</p>
              <h3 class="text-3xl font-bold text-[#1B3A5C] mb-5">The handover moment, recorded.</h3>
              <p class="text-[#6B7280] leading-relaxed">
                Guests walk through five systems at handover, flag what they find, and attach photos directly to each issue. Reports are timestamped and attached to each boat's permanent record automatically — no manual entry from your team.
              </p>
            </div>
          </div>

          <!-- Feature 3 -->
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-[#D4A843] mb-3">Reviews</p>
              <h3 class="text-3xl font-bold text-[#1B3A5C] mb-5">Structured feedback your team can act on.</h3>
              <p class="text-[#6B7280] leading-relaxed">
                Category ratings across five systems — safety, rigging, engine, hull, comfort — with photos attached to the specific systems that matter. Not a holiday rating: structured condition data your maintenance team can use to prioritise work between rotations.
              </p>
            </div>
            <div class="bg-white rounded-2xl p-8 border border-[#E5E7EB] shadow-sm">
              <div class="flex items-start justify-between mb-5">
                <div>
                  <p class="font-bold text-[#111827]">Beneteau Oceanis 45</p>
                  <p class="text-sm text-[#6B7280]">Croatia · June 2025 · 7 days</p>
                </div>
                <span class="text-[#D4A843] text-lg">★★★★☆</span>
              </div>
              <div class="space-y-3">
                {[
                  { label: 'Safety', rating: 5 },
                  { label: 'Rigging', rating: 5 },
                  { label: 'Engine', rating: 4 },
                  { label: 'Hull', rating: 4 },
                  { label: 'Comfort', rating: 4 },
                ].map(({ label, rating }) => (
                  <div class="flex items-center gap-3">
                    <span class="text-sm text-[#6B7280] w-24 flex-shrink-0">{label}</span>
                    <div class="flex-1 bg-[#F5F5F5] rounded-full h-1.5">
                      <div class="bg-[#D4A843] h-1.5 rounded-full" style={`width:${rating / 5 * 100}%`}></div>
                    </div>
                    <span class="text-sm font-semibold text-[#111827]">{rating}/5</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- REQUEST ACCESS CTA -->
    <section class="bg-[#1B3A5C] py-24">
      <div class="max-w-2xl mx-auto px-6 text-center">
        <h2 class="text-4xl font-bold text-white mb-5">Ready to see your fleet through your guests' eyes?</h2>
        <p class="text-white/70 text-lg mb-10">Free during early access. No setup required — we onboard your fleet together.</p>
        <a
          href={REQUEST_ACCESS_URL}
          class="inline-block bg-gradient-to-r from-[#D4A843] to-[#C49833] text-white font-bold text-lg px-10 py-4 rounded-xl hover:opacity-90 active:scale-95 transition-all"
        >
          Request early access
        </a>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="bg-white py-24">
      <div class="max-w-2xl mx-auto px-6">
        <div class="text-center mb-12">
          <p class="text-xs font-bold uppercase tracking-widest text-[#D4A843] mb-4">FAQ</p>
          <h2 class="text-4xl font-bold text-[#1B3A5C]">Common questions</h2>
        </div>
        <div class="space-y-3">
          {[
            {
              q: 'What does setup look like for my fleet?',
              a: 'We onboard your fleet together — typically one short call. We add your boats to the database, and from that point guests can start filing check-in reports automatically. No integration or technical setup required on your side.',
            },
            {
              q: 'How does my fleet data stay private?',
              a: "Condition reports and issue data are visible to guests who charter your boats and to you. We are building a fleet dashboard that will give you direct access to your fleet's condition data. Your fleet is not searchable by competitors or the general public beyond what a booked guest can see.",
            },
            {
              q: 'Can I respond to reported issues?',
              a: "Not yet — but this is on the roadmap. When an issue is marked as fixed by a subsequent guest, the condition score updates immediately. The fleet dashboard (in development) will let you log maintenance actions directly against open issues.",
            },
            {
              q: 'Is CharterWise free?',
              a: 'Free during early access. We are building the product with our first fleet partners before introducing any paid tiers — your feedback shapes what gets built.',
            },
            {
              q: 'Why did you create CharterWise?',
              a: "I've chartered many boats across the Mediterranean, Caribbean, and beyond. Every time, I arrived without context about the boat's true condition. I built CharterWise to capture the handover moment — and realised the data is just as valuable to the company running the fleet as it is to the sailor stepping aboard.",
            },
          ].map(({ q, a }) => (
            <details class="group bg-[#F8F6F1] rounded-xl border border-[#E5E7EB] overflow-hidden">
              <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer font-semibold text-[#111827] list-none select-none">
                {q}
                <span class="text-[#6B7280] transition-transform group-open:rotate-180 flex-shrink-0 text-xs">▾</span>
              </summary>
              <p class="px-6 pb-5 text-[#6B7280] leading-relaxed">{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="bg-[#1B3A5C] text-white/60 py-10">
    <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm">
      <div class="flex items-center gap-2.5">
        <img src="/icon.png" alt="CharterWise" class="h-6 w-6 rounded-md object-cover opacity-80" />
        <span>
          <span class="font-bold text-white">CharterWise</span>
          <span class="ml-2">— Fleet condition intelligence for charter companies.</span>
        </span>
      </div>
      <div class="flex items-center gap-6">
        <a href="/about" class="hover:text-white transition-colors">About</a>
        <a href="/privacy" class="hover:text-white transition-colors">Privacy</a>
        <a href="mailto:hello@charterwise.app" class="hover:text-white transition-colors">Contact</a>
      </div>
    </div>
    <div class="max-w-6xl mx-auto px-6 mt-6 flex flex-col sm:flex-row items-center justify-between gap-2">
      <p class="text-xs text-white/30">© {new Date().getFullYear()} CharterWise.</p>
      <a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" class="text-xs text-white/30 hover:text-white/60 transition-colors">
        Are you a sailor? Get the app →
      </a>
    </div>
  </footer>

  <script>
    // Lightbox
    const lightbox = document.getElementById('lightbox')!;
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxLabel = document.getElementById('lightbox-label')!;

    const thumbs = Array.from(document.querySelectorAll('.screenshot-thumb')) as HTMLElement[];
    let currentIndex = 0;

    const showSlide = (index: number) => {
      currentIndex = (index + thumbs.length) % thumbs.length;
      lightboxImg.src = thumbs[currentIndex].dataset.src!;
      lightboxImg.alt = thumbs[currentIndex].dataset.label!;
      lightboxLabel.textContent = thumbs[currentIndex].dataset.label!;
    };

    const openLightbox = (index: number) => {
      showSlide(index);
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
    };

    thumbs.forEach((btn, i) => {
      btn.addEventListener('click', () => openLightbox(i));
    });

    document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
    document.getElementById('lightbox-prev')?.addEventListener('click', (e) => { e.stopPropagation(); showSlide(currentIndex - 1); });
    document.getElementById('lightbox-next')?.addEventListener('click', (e) => { e.stopPropagation(); showSlide(currentIndex + 1); });
    lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('flex')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') showSlide(currentIndex - 1);
      if (e.key === 'ArrowRight') showSlide(currentIndex + 1);
    });
  </script>
</Layout>
